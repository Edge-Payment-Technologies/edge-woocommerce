<?xml version="1.0"?>
<ruleset name="Edge WooCommerce Gateway">
	<description>Coding standards for the Edge Payments gateway.</description>

	<file>edge-gateway.php</file>
	<file>includes</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<!--
		Targets match the plugin header: WooCommerce 11 requires PHP 7.4 and
		WordPress 6.9, so those are the floors this code has to hold to. The
		previous values here were PHP 5.6 and WordPress 4.7.
	-->
	<config name="minimum_supported_wp_version" value="6.9"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress-Extra">
		<!-- WooCommerce dictates these class and file names, not us. -->
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>
	</rule>

	<rule ref="WordPress-Docs"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="edge-gateway"/>
		</properties>
	</rule>
</ruleset>
